<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itzx.electronics.mapper.DetailMapper">
    <select id="findDetailById"
            parameterType="int"
            resultType="com.itzx.electronics.entity.Detail">
        select
            d.id,
            d.description as text,
            d.origin,
            p.image_url as imageUrl,
            d.spec,
            d.create_time,
            d.update_time
        from product p
                 join detail d on p.detail_id = d.id
        where p.id = #{id}
    </select>
</mapper>

